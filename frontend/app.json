{
  "expo": {
    "name": "VOOM Crm",
    "slug": "voom-crm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "voom-crm",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.voom.crm",
      "buildNumber": "2",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Per registrare visite, ispezioni e georeferenziare i rimborsi",
        "NSLocationAlwaysUsageDescription": "Per rilevare la posizione durante le visite e i rimborsi",
        "NSCameraUsageDescription": "Per scattare foto di ispezioni e scontrini di rimborso",
        "NSPhotoLibraryUsageDescription": "Per selezionare foto dalla galleria",
        "NSFaceIDUsageDescription": "Per accesso rapido sicuro all'app",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#C2410C"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.voom.crm",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#C2410C"
        }
      ],
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "Per allegare foto alle ispezioni",
          "cameraPermission": "Per scattare foto durante le visite"
        }
      ],
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
