# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.yarn/install-state.gz

# Production builds
/build
dist
dist/
/out/
.expo/
web-build/

# Next.js
/.next/
next-env.d.ts

# Build caches
.cache/
*.tsbuildinfo
*.pack
.metro-cache/

# Python
__pycache__/
*pyc*
venv/
.venv/
.ipynb_checkpoints/

# Mobile development
android-sdk/

# Testing
/coverage

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE and editors
.idea/
.vscode/

# System files
.DS_Store

# Deployment
.vercel

# Data and databases
dump.rdb
agenthub/agents/youtube/db
.chainlit
chainlit.md
.ac

# Archive files and large assets
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.zip
*.deb
*.dylib

# Credential files (NOTE: .env files are intentionally NOT ignored —
# required by the deployment build context; secrets are platform-managed)
*.pem
*.key
.credentials
credentials.json
*credentials.json*
*token.json*
memory/test_credentials.md
